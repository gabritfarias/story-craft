datasource db {
  provider = "sqlite"
  url      = "file:./storycraft.db"
}

generator client {
  provider = "prisma-client-js"
}

model Story {
  id        Int      @id @default(autoincrement())
  title     String   @default("Meu Story")
  data      String   // JSON stringificado com as camadas, textos e imagens do canvas
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id         String   @id @default(cuid())
  name       String
  textLayers String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
